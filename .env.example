# LLM
GEMINI_API_KEY=
LLM_MODEL=gemini/gemini-2.5-flash

# PubMed (optional)
PUBMED_API_KEY=
PUBMED_EMAIL=

# Langfuse (from Langfuse UI → Settings → API Keys)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# Langfuse server secrets (only needed for self-hosted Langfuse)
# Generate with: openssl rand -base64 32
LANGFUSE_NEXTAUTH_SECRET=
LANGFUSE_SALT=

# Qdrant (override only if running outside Docker compose)
# QDRANT_URL=http://localhost:6333

LOG_LEVEL=INFO
